# Dependencies
node_modules/
.worktrees/

# OS junk
.DS_Store
Thumbs.db

# Keep original photos out of git by default (they can be large / private).
# The build step converts them into site/photos/*.jpg which ARE committed and served.
# Remove the lines below if you DO want to commit your originals too.
assets/*.HEIC
assets/*.heic
assets/*.HEIF
assets/*.heif
assets/*.JPG
assets/*.jpg
assets/*.JPEG
assets/*.jpeg
assets/*.PNG
assets/*.png
assets/*.WEBP
assets/*.webp

# NOTE: site/data.json and site/photos/*.jpg are intentionally NOT ignored --
# they are generated by `npm run build` and must be committed for GitHub Pages.
